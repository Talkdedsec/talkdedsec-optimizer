{
  "name": "talkdedsec",
  "productName": "Talkdedsec",
  "version": "1.1.0",
  "description": "Windows performance, privacy and cleanup tweaks with one-click undo. No account, no telemetry.",
  "author": "Talkdedsec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talkdedsec/talkdedsec-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/Talkdedsec/talkdedsec-optimizer/issues"
  },
  "homepage": "https://talkdedsec.com",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test test/engine.test.ts",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.talkdedsec.app",
    "productName": "Talkdedsec",
    "copyright": "Copyright (c) 2026 Talkdedsec",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Talkdedsec-Setup-${version}.${ext}"
    },
    "extraMetadata": {
      "description": "Talkdedsec"
    },
    "portable": {
      "artifactName": "Talkdedsec-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
